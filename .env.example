# Smart Campus AI - Environment Configuration
PORT=3000
JWT_SECRET=change-this-to-a-long-secure-random-secret-key

# Optional: Google Gemini API configuration
# Enables Gemini-powered student advisor, doubt solver, and study planner.
# Without it, the system operates seamlessly using its built-in offline intelligence engine.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
