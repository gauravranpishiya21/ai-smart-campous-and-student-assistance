# Smart Campus AI - Environment Configuration

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Mandatory Security Key: at least 32 characters (server will exit if missing or short)
JWT_SECRET=change-this-to-a-long-secure-random-secret-key-at-least-32-chars

# Google Gemini API configuration (Optional but recommended)
# Enables Gemini-powered student advisor, doubt solver, study planner, risk explanations, and triage.
# Without it, the system operates seamlessly using its built-in offline intelligence engine.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database Persistence Path (Default: data/campus.db)
DB_FILE=

# Security & Reverse Proxy Settings
CORS_ORIGIN=
TRUST_PROXY=1

# Logging & Operational Configuration
LOG_LEVEL=info
AUTOMATION=true
